#!/bin/sh

echo ""
echo "========================================="
echo "  Pre-push checks starting..."
echo "========================================="
echo ""

# 1. Lint (informational - does not block push)
#    next build includes its own lint step, so this is for early feedback only.
echo "[1/3] Running lint (informational)..."
npm run lint 2>&1 | tail -5
echo "[1/3] Lint check complete (see above for any warnings)."
echo ""

# 2. Test (BLOCKING)
echo "[2/3] Running tests..."
npm run test:run
if [ $? -ne 0 ]; then
  echo ""
  echo "========================================="
  echo "  Tests FAILED. Push aborted."
  echo "========================================="
  exit 1
fi
echo "[2/3] Tests passed."
echo ""

# 3. Build (BLOCKING - the production gate)
echo "[3/3] Running production build..."
npm run build
if [ $? -ne 0 ]; then
  echo ""
  echo "========================================="
  echo "  Build FAILED. Push aborted."
  echo "========================================="
  exit 1
fi
echo "[3/3] Build passed."
echo ""

echo "========================================="
echo "  All checks passed. Pushing..."
echo "========================================="
echo ""
